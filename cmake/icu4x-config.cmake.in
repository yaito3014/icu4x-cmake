@PACKAGE_INIT@

# icu4x is distributed as a prebuilt static library plus the ICU4X C++ bindings
# headers. Recreate the imported targets against the install prefix so this
# package is relocatable.
if(NOT TARGET icu4x::icu4x)
    if(WIN32)
        set(_icu4x_lib_name icu_capi.lib)
    else()
        set(_icu4x_lib_name libicu_capi.a)
    endif()

    # Private imported target for the prebuilt static library. Mirrors the
    # build-tree target of the same name; it deliberately carries no include
    # directories. Downstream code must link icu4x::icu4x, not this.
    add_library(_icu4x_imported STATIC IMPORTED)
    set_target_properties(
        _icu4x_imported
        PROPERTIES
            IMPORTED_LOCATION
                "@PACKAGE_CMAKE_INSTALL_LIBDIR@/${_icu4x_lib_name}"
            INTERFACE_LINK_LIBRARIES "@ICU4X_NATIVE_STATIC_LIBS@"
            INTERFACE_LINK_OPTIONS "@ICU4X_NATIVE_STATIC_LINK_OPTIONS@"
    )

    # Public target: bundles the static library and the ICU4X C++ headers.
    add_library(icu4x::icu4x INTERFACE IMPORTED)
    set_target_properties(
        icu4x::icu4x
        PROPERTIES
            INTERFACE_LINK_LIBRARIES _icu4x_imported
            INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@"
    )

    unset(_icu4x_lib_name)
endif()

check_required_components(icu4x)
