@PACKAGE_INIT@

# icu4x is distributed as a prebuilt static library plus the ICU4X C++ bindings
# headers. Recreate the imported targets against the install prefix so this
# package is relocatable.
if(NOT TARGET icu4x::icu4x)
    # Static library file name, baked at install time from the platform that
    # built it (the archive is platform-specific, so no runtime branch needed).
    set(_icu4x_lib_name
        "@CMAKE_STATIC_LIBRARY_PREFIX@icu_capi@CMAKE_STATIC_LIBRARY_SUFFIX@"
    )

    # Private imported target for the prebuilt static library. Mirrors the
    # build-tree target of the same name; it deliberately carries no include
    # directories. Downstream code must link icu4x::icu4x, not this. GLOBAL so
    # it stays visible when find_package(icu4x) is called from a subdirectory.
    add_library(_icu4x_imported STATIC IMPORTED GLOBAL)
    set_target_properties(
        _icu4x_imported
        PROPERTIES
            IMPORTED_LOCATION
                "@PACKAGE_CMAKE_INSTALL_LIBDIR@/icu4x/${_icu4x_lib_name}"
            INTERFACE_LINK_LIBRARIES "@ICU4X_NATIVE_STATIC_LIBS@"
            INTERFACE_LINK_OPTIONS "@ICU4X_NATIVE_STATIC_LINK_OPTIONS@"
    )

    # Public target: bundles the static library and the ICU4X C++ headers.
    # GLOBAL so a find_package(icu4x) call in a subdirectory still exposes
    # icu4x::icu4x to sibling directories.
    add_library(icu4x::icu4x INTERFACE IMPORTED GLOBAL)
    set_target_properties(
        icu4x::icu4x
        PROPERTIES
            INTERFACE_LINK_LIBRARIES _icu4x_imported
            INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@"
    )

    unset(_icu4x_lib_name)
endif()

check_required_components(icu4x)
